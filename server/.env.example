# Copy to server/.env and fill in. Never commit the real .env file.

# Server
PORT=7778
NODE_ENV=development # set to "production" when deployed (enables Secure, cross-site cookies)

# Database
MONGODB_URI=your_mongodb_connection_string

# Authentication — required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret

# Frontend URL: where OAuth sign-ins redirect back to, and an allowed CORS/socket origin.
CLIENT_URL=http://localhost:5173
# Optional extra allowed origins, comma separated (e.g. a custom domain).
ALLOWED_ORIGINS=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:7778/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:7778/auth/github/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:7778/auth/linkedin/callback
